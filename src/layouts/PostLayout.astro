---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, readingTime, slugifyTag } from '@/lib/format';
import { getCategoryMeta } from '@/lib/categories';
import CategoryBadge from '@/components/CategoryBadge.astro';
import PostCard from '@/components/PostCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  related: CollectionEntry<'blog'>[];
}

const { post, related } = Astro.props;
const { title, excerpt, date, category, tags, author, slug } = post.data;
const minutes = post.data.readingTime ?? readingTime(post.body ?? '');
const categoryMeta = getCategoryMeta(category);
---

<BaseLayout
  title={title}
  description={excerpt}
  image={`/og/${category}/${slug}.png`}
  type="article"
  publishedTime={date}
  tags={tags}
  category={categoryMeta?.label ?? category}
  author={author}
>
  <article class="wrap post">
    <header class="post__header">
      <CategoryBadge category={category} size="md" />
      <h1>{title}</h1>
      <p class="post__meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min czytania</span>
        <span aria-hidden="true">·</span>
        <span>{author}</span>
      </p>
    </header>

    <hr class="hairline post__rule" />

    <div class="prose">
      <slot />
    </div>

    {tags.length > 0 && (
      <footer class="post__tags">
        {tags.map((tag) => (
          <a class="tag" href={`/tag/${slugifyTag(tag)}/`}>#{tag}</a>
        ))}
      </footer>
    )}

    <nav class="post__back">
      <a href={`/kategoria/${category}/`} class="btn">← Więcej z kategorii {categoryMeta?.label ?? category}</a>
    </nav>
  </article>

  {related.length > 0 && (
    <section class="wrap related">
      <p class="section-label">Powiązane artykuły</p>
      <div class="related__list">
        {related.map((item) => <PostCard post={item} />)}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .post {
    padding-block: clamp(2.5rem, 5vw, 5rem);
  }

  .post__header {
    max-width: var(--measure);
  }

  .post__header h1 {
    margin-top: 0.6rem;
  }

  .post__meta {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    display: flex;
    gap: 0.6rem;
    margin: 0.75rem 0 0;
  }

  .post__rule {
    margin: 2.25rem 0;
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 3rem;
  }

  .post__back {
    margin-top: 3rem;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.75rem;
    margin-bottom: 0;
  }

  .related {
    padding-block: 1rem clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--color-border);
  }
</style>
