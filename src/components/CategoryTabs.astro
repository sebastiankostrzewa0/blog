---
import { CATEGORIES } from '@/lib/categories';

interface Props {
  /** Category slug currently active, or undefined for "Wszystkie" (the /blog index). */
  active?: string;
}

const { active } = Astro.props;
---

<nav class="category-tabs" aria-label="Filtruj po kategorii">
  <a href="/blog/" class="category-tabs__item" aria-current={!active ? 'page' : undefined}>
    Wszystkie
  </a>
  {CATEGORIES.map((cat) => (
    <a
      href={`/kategoria/${cat.slug}/`}
      class="category-tabs__item"
      aria-current={active === cat.slug ? 'page' : undefined}
    >
      {cat.label}
    </a>
  ))}
</nav>

<style>
  .category-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .category-tabs__item {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-fg-muted);
    border: 1px solid var(--color-grid);
    border-radius: 999px;
    padding: 0.4em 0.95em;
  }

  .category-tabs__item:hover,
  .category-tabs__item:focus-visible {
    color: var(--color-ink);
    border-color: var(--color-ink);
  }

  .category-tabs__item[aria-current='page'] {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }
</style>
