---
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION, SITE_LOCALE, SITE_AUTHOR } from '@/consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  category?: string;
  author?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  category,
  author = SITE_AUTHOR,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} - ${SITE_TITLE}` : `${SITE_TITLE} - ${SITE_TAGLINE}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image ?? '/og/default.png', Astro.site);

const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description,
        image: ogImageURL.toString(),
        datePublished: publishedTime?.toISOString(),
        dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
        author: { '@type': 'Person', name: author },
        publisher: { '@type': 'Person', name: SITE_TITLE },
        mainEntityOfPage: canonicalURL.toString(),
        articleSection: category,
        keywords: tags.join(', ') || undefined,
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_TITLE,
        description: SITE_DESCRIPTION,
        url: Astro.site?.toString(),
      };
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={SITE_LOCALE.replace('-', '_')} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title ?? SITE_TITLE} />

{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}
{type === 'article' && category && <meta property="article:section" content={category} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
