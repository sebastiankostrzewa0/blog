---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/lib/format';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, pubDate, tags } = post.data;
---

<article class:list={['post-card', { 'post-card--featured': featured }]}>
  <a href={`/blog/${post.id}/`} class="post-card__link">
    <p class="post-card__meta">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      {tags.length > 0 && (
        <>
          <span aria-hidden="true">·</span>
          <span>{tags.slice(0, 2).join(' / ')}</span>
        </>
      )}
    </p>
    <h3 class="post-card__title">{title}</h3>
    <p class="post-card__desc">{description}</p>
    <span class="post-card__cta">Czytaj dalej →</span>
  </a>
</article>

<style>
  .post-card {
    border-top: 1px solid var(--color-border);
    padding-block: 2rem;
  }

  .post-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .post-card__meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    margin-bottom: 0.6rem;
    display: flex;
    gap: 0.5rem;
  }

  .post-card__title {
    margin: 0 0 0.5rem;
    font-size: clamp(1.4rem, 1.4vw + 1rem, 2rem);
    transition: color 160ms ease;
  }

  .post-card__link:hover .post-card__title,
  .post-card__link:focus-visible .post-card__title {
    color: var(--color-signal);
  }

  .post-card__desc {
    color: var(--color-fg-muted);
    max-width: 62ch;
    margin-bottom: 0.75rem;
  }

  .post-card__cta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-signal);
  }

  .post-card--featured .post-card__title {
    font-size: clamp(2rem, 3vw + 1rem, 3rem);
  }
</style>
