---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '@/lib/format';
import CategoryBadge from '@/components/CategoryBadge.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, excerpt, date, category, tags, slug } = post.data;
const minutes = post.data.readingTime ?? readingTime(post.body ?? '');
---

<article class:list={['post-card', { 'post-card--featured': featured }]}>
  <a href={`/${category}/${slug}/`} class="post-card__link">
    <p class="post-card__meta">
      <CategoryBadge category={category} asLink={false} />
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <span aria-hidden="true">·</span>
      <span>{minutes} min czytania</span>
    </p>
    <h3 class="post-card__title">{title}</h3>
    <p class="post-card__desc">{excerpt}</p>
    {tags.length > 0 && (
      <p class="post-card__tags">{tags.map((tag) => `#${tag}`).join('  ')}</p>
    )}
    <span class="post-card__cta">Czytaj dalej →</span>
  </a>
</article>

<style>
  .post-card {
    border-top: 1px solid var(--color-border);
    padding-block: 2rem;
  }

  .post-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .post-card__meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    margin-bottom: 0.85rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .post-card__title {
    margin: 0 0 0.5rem;
    font-size: clamp(1.4rem, 1.4vw + 1rem, 2rem);
    transition: color 160ms ease;
  }

  .post-card__link:hover .post-card__title,
  .post-card__link:focus-visible .post-card__title {
    color: var(--color-signal);
  }

  .post-card__desc {
    color: var(--color-fg-muted);
    max-width: 62ch;
    margin-bottom: 0.6rem;
  }

  .post-card__tags {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-fg-muted);
    margin-bottom: 0.75rem;
  }

  .post-card__cta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-signal);
  }

  .post-card--featured .post-card__title {
    font-size: clamp(2rem, 3vw + 1rem, 3rem);
  }
</style>
