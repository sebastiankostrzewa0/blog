---
import { getCategoryMeta } from '@/lib/categories';

interface Props {
  category: string;
  /** Render as a link to the category index (default) or as static text. */
  asLink?: boolean;
  size?: 'sm' | 'md';
}

const { category, asLink = true, size = 'sm' } = Astro.props;
const meta = getCategoryMeta(category);
const label = meta?.label ?? category;
---

{asLink ? (
  <a href={`/kategoria/${category}/`} class:list={['category-badge', `category-badge--${size}`]}>
    {label}
  </a>
) : (
  <span class:list={['category-badge', `category-badge--${size}`]}>{label}</span>
)}

<style>
  .category-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink);
    background: var(--color-paper);
    border: 1px solid var(--color-grid);
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
  }

  .category-badge--sm {
    font-size: 0.7rem;
    padding: 0.25em 0.75em;
  }

  .category-badge--md {
    font-size: 0.8rem;
    padding: 0.35em 0.95em;
  }

  a.category-badge:hover,
  a.category-badge:focus-visible {
    border-color: var(--color-signal);
    color: var(--color-signal);
  }
</style>
