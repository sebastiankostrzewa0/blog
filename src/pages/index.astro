---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '@/lib/publishing';
import { RAISLY_URL } from '@/consts';

const posts = (await getCollection('blog', isPublished)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const [featured, ...rest] = posts;
---

<BaseLayout>
  <section class="hero">
    <div class="blueprint-grid"></div>
    <div class="wrap hero__inner">
      <p class="eyebrow">Nieruchomości · PropTech · Biznes</p>
      <h1>Buduję firmy<br />i piszę o tym, co działa.</h1>
      <p class="hero__lede">
        Cześć, jestem Sebastian — founder <a href={RAISLY_URL} target="_blank" rel="noopener noreferrer">Raisly</a>,
        gdzie pomagamy firmom z branży nieruchomości i budownictwa działać sprawniej dzięki
        technologii. Ten blog to zapis tego, czego uczę się po drodze: o rynku, architekturze,
        finansowaniu inwestycji i technologii, która realnie zmienia tę branżę.
      </p>
      <div class="hero__actions">
        <a href="/biznes/" class="btn btn--accent">Czytaj artykuły</a>
        <a href="/rss.xml" class="btn">RSS</a>
      </div>
    </div>
  </section>

  {featured && (
    <section class="wrap featured">
      <p class="section-label">Najnowszy</p>
      <PostCard post={featured} featured />
    </section>
  )}

  {rest.length > 0 && (
    <section class="wrap archive">
      <p class="section-label">Pozostałe artykuły</p>
      <div class="archive__list">
        {rest.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(3rem, 8vw, 7rem) clamp(2.5rem, 6vw, 5rem);
    max-width: 60rem;
  }

  .hero h1 {
    margin-top: 0.4rem;
  }

  .hero__lede {
    max-width: 46rem;
    font-size: 1.15rem;
    color: var(--color-fg-muted);
  }

  .hero__lede a {
    color: var(--color-signal);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.75rem;
    margin-bottom: 0;
  }

  .featured {
    padding-block: clamp(2rem, 4vw, 3rem) 1rem;
  }

  .archive {
    padding-block: 1rem clamp(3rem, 6vw, 5rem);
  }
</style>
