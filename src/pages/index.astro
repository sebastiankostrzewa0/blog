---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CompactPostList from '@/components/CompactPostList.astro';
import NewsletterForm from '@/components/NewsletterForm.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '@/lib/publishing';

const posts = (await getCollection('blog', isPublished)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const latest = posts.slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <div class="blueprint-grid"></div>
    <div class="wrap hero__grid">
      <div class="hero__main">
        <p class="eyebrow">Nieruchomości · Prawo · Dane · Design</p>
        <h1>Piszę o nieruchomościach bez lukru.</h1>
        <p class="hero__lede">
          Cześć, jestem Sebastian. Na co dzień pracuję jako PM w firmie deweloperskiej -
          widzę różnicę między tym, co idzie do marketingu, a tym, co faktycznie ląduje
          w umowie i na budowie. Piszę o rynku, zmianach w prawie, danych i designie
          w nieruchomościach - czasem wygodnie dla branży, czasem nie.
        </p>
        <div class="hero__actions">
          <a href="/blog/" class="btn btn--accent">Czytaj artykuły</a>
          <a href="/rss.xml" class="btn">RSS</a>
        </div>
      </div>

      {latest.length > 0 && (
        <aside class="hero__aside" aria-label="Najnowsze artykuły">
          <p class="section-label">Najnowsze</p>
          <CompactPostList posts={latest} />
        </aside>
      )}
    </div>
  </section>

  <section class="wrap newsletter-section">
    <NewsletterForm />
  </section>
</BaseLayout>

<style>
  .newsletter-section {
    padding-block: 0 clamp(3rem, 6vw, 5rem);
  }

  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    padding-block: clamp(3rem, 7vw, 6rem);
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .hero h1 {
    margin-top: 0.4rem;
  }

  .hero__lede {
    font-size: 1.1rem;
    color: var(--color-fg-muted);
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .hero__aside {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 1.5rem;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    margin: 0 0 0.25rem;
  }

  @media (max-width: 56rem) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
