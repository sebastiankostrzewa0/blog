---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [featured, ...rest] = posts;
---

<BaseLayout>
  <section class="wrap hero">
    <p class="eyebrow">Pismo o dobrym rzemiośle</p>
    <h1>Pisanie, projektowanie<br />i rzeczy zrobione na lata.</h1>
    <p class="hero__lede">
      Meridian to niewielkie archiwum notatek o warsztacie: jak myśleć o formie, jak pisać
      zdania, które się nie starzeją, i jak budować produkty bez pośpiechu.
    </p>
    <div class="hero__actions">
      <a href="/blog/" class="btn btn--accent">Czytaj artykuły</a>
      <a href="/rss.xml" class="btn">RSS</a>
    </div>
  </section>

  {featured && (
    <section class="wrap featured">
      <p class="section-label">Najnowszy</p>
      <PostCard post={featured} featured />
    </section>
  )}

  {rest.length > 0 && (
    <section class="wrap archive">
      <p class="section-label">Archiwum</p>
      <div class="archive__list">
        {rest.map((post) => <PostCard post={post} />)}
      </div>
      <div class="archive__more">
        <a href="/blog/" class="btn">Zobacz wszystkie →</a>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 7rem) clamp(2rem, 5vw, 4rem);
    max-width: 60rem;
  }

  .hero h1 {
    margin-top: 0.4rem;
  }

  .hero__lede {
    max-width: 46rem;
    font-size: 1.15rem;
    color: var(--color-fg-muted);
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.75rem;
    margin-bottom: 0;
  }

  .featured {
    padding-block: 1rem 1rem;
  }

  .archive {
    padding-block: 1rem clamp(3rem, 6vw, 5rem);
  }

  .archive__more {
    margin-top: 2rem;
  }
</style>
